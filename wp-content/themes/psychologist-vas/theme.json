				},
				{
					"fluid": false,
					"name": "Large",
					"size": "clamp(1.563rem, 1.123rem + 1.88vw, 3.375rem)",
					"slug": "large"
				},
				{
					"fluid": false,
					"name": "X-Large",
					"size": "clamp(1.563rem, 0.576rem + 4.21vw, 5.625rem)",
					"slug": "x-large"
				}
			],
			"writingMode": true
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bezh)",
			"text": "var(--wp--preset--color--blue)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--blue)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontWeight": "100"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--blue)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--blue)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--blue)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)"
				}
			}
		},
		"spacing": {
			"blockGap": "0px"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--montserrat)",
			"fontSize": "var(--wp--preset--font-size--tiny)"
		},
		"css": "* { padding: 0; margin: 0; outline: none; scroll-behavior: smooth; font-family: \"Montserrat\", sans-serif; color: var(--wp--preset--color--blue); } *::-webkit-scrollbar { width: 8px; height: 8px; } *::-webkit-scrollbar-track { background: var(--wp--preset--color--white); } *::-webkit-scrollbar-thumb { background: var(--wp--preset--color--blue); border-radius: 10px; } *::-moz-selection { color: var(--wp--preset--color--blue); background: var(--wp--preset--color--bezh); } *::selection { color: var(--wp--preset--color--blue); background: var(--wp--preset--color--bezh); } body { background: var(--wp--preset--color--white); } .body-overflow { overflow: hidden; } a, a strong { cursor: pointer; text-decoration: none; transition: 0.3s; -webkit-tap-highlight-color: transparent; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); } a:hover, a strong:hover { transition: 0.3s; opacity: 0.7; } li { -webkit-tap-highlight-color: transparent; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); } button { border: none; background: none; cursor: pointer; transition: 0.3s; -webkit-tap-highlight-color: transparent; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); } button:hover { transition: 0.3s; opacity: 0.7; } .container { box-sizing: border-box; width: 100%; margin: 0 auto; max-width: 1720px; padding: 0 20px; } @media (max-width: 1700px) { .container { padding: 0 40px; } } @media (max-width: 1400px) { .container { max-width: 1140px; padding: 0 20px; } } @media (max-width: 1199px) { .container { max-width: 960px; } } @media (max-width: 991px) { .container { max-width: 720px; } } @media (max-width: 767px) { .container { max-width: 540px; } } @media (max-width: 575px) { .container { padding: 0 20px; } }"
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
