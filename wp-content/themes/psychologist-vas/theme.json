			"fontSizes": [
				{
					"fluid": false,
					"name": "Tiny",
					"size": "clamp(0.938rem, 0.922rem + 0.06vw, 1rem)",
					"slug": "tiny"
				},
				{
					"fluid": false,
					"name": "Small",
					"size": "clamp(0.938rem, 0.831rem + 0.45vw, 1.375rem)",
					"slug": "small"
				},
				{
					"fluid": false,
					"name": "Medium",
					"size": "clamp(1.125rem, 0.943rem + 0.78vw, 1.875rem)",
