{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#1B3D58",
					"name": "Blue",
					"slug": "blue"
				},
				{
					"color": "#F5F2ED",
					"name": "White",
					"slug": "white"
				},
				{
					"color": "#EBDED6",
					"name": "Bezh",
					"slug": "bezh"
				}
			]
		},
		"layout": {
			"contentSize": "1720px",
			"wideSize": "1920px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "20px",
					"slug": "tiny"
				},
				{
					"name": "X-Small",
					"size": "clamp(1.125rem, 0.943rem + 0.78vw, 1.875rem);",
					"slug": "x-small"
				},
				{
					"name": "Small",
					"size": "clamp(1.25rem, 1.098rem + 0.65vw, 1.875rem)",
					"slug": "small"
				},
				{
					"name": "Regular",
					"size": "clamp(1.563rem, 1.183rem + 1.62vw, 3.125rem)",
					"slug": "regular"
				},
				{
					"name": "Large",
					"size": "clamp(1.875rem, 1.117rem + 3.24vw, 5rem);",
					"slug": "large"
				},
				{
					"name": "X-Large",
					"size": "clamp(3.125rem, 2.063rem + 4.53vw, 7.5rem)",
					"slug": "x-large"
				}
			],
			"units": [
