{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "snd/main",
  "version": "0.1.0",
  "title": "Посадочный блок",
  "category": "snd-blocks",
  "icon": "cover-image",
  "example": {
    "viewportWidth": 1200
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "title": {
      "type": "string",
      "default": "Смирнова Виктория Александровна"
    },
    "subtitle": {
      "type": "string",
      "default": "Психологические консультации для&nbsp;деловых людей от&nbsp;психоаналитика..."
    },
    "imageBg": {
      "type": "object",
      "default": {
        "id": 0,
        "url": "",
        "alt": "",
        "size": "large",
        "sizes": {}
      }
    },
    "imageMobile": {
      "type": "object",
      "default": {
        "id": 0,
        "url": "",
        "alt": "",
        "size": "large",
        "sizes": {}
      }
    },
    "button": {
      "type": "object",
      "default": {
        "name": "Записаться на консультацию →",
        "href": "/",
        "target": false
      }
    },
    "currentSocListId": {
      "type": "string",
      "default": "new"
    },
    "currentSocList": {
      "type": "array",
      "default": []
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": true
  },
  "textdomain": "sndpshsite-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [
    "file:./style-index.css"
  ],
  "render": "file:./render.php"
}